    "axes[2].barh(perm_s.index, perm_s.values, xerr=perm_std.values, color=\"darkorange\")\n",
    "axes[2].set_title(\"Importancia por permutación (aumento del MAE)\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
